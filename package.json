{
  "name": "vela",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A calm car dashboard PWA: navigation without a street map, plus music, podcasts and books from your own services.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@openuidev/lang-core": "1.0.1",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "zod": "4.6.7"
  }
}

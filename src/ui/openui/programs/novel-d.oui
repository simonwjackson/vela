root = Screen(stage, chip)
chip = Chip("Arrived", "flag")
stage = Stage(answer, nearby, shelf)
answer = Stack([driven, summary])
driven = Hero("trip.driven", "driven this trip")
summary = Facts([timeFact, avgFact, stopsFact])
timeFact = Fact("Time", "trip.time")
avgFact = Fact("Average", "trip.avg")
stopsFact = Fact("Stops", "trip.stops")
nearby = Card([places], "Near you")
places = List([cafe, fuel])
cafe = PlaceRow("suggest.0", @StartRoute("suggest.0"))
fuel = PlaceRow("suggest.1", @StartRoute("suggest.1"))
shelf = Shelf()

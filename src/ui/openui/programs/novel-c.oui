root = Screen(stage)
stage = Stage(answer, fuel, trip)
answer = Hero("nav.next")
fuel = Card([fuelFacts, stations], "Fuel is low")
fuelFacts = Facts([rangeFact, leftFact])
rangeFact = Fact("Range", "car.range")
leftFact = Fact("To go", "trip.distance")
stations = List([station0, station1])
station0 = PlaceRow("suggest.0", @AddStop("suggest.0"))
station1 = PlaceRow("suggest.1", @AddStop("suggest.1"))
trip = TripRow()
